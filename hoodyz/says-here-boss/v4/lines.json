[{"name": "h1", "start": 0.1, "dur": 1.8799583333333334, "text": "Says here you used to be our boss?"}, {"name": "g1", "start": 2.2666666666666666, "dur": 0.6170208333333334, "text": "Yes."}, {"name": "g2", "start": 12.1, "dur": 0.9573541666666666, "text": "Thank you, sir."}, {"name": "h2", "start": 13.166666666666666, "dur": 1.8124583333333333, "text": "I've had these for years."}, {"name": "g3", "start": 15.0, "dur": 0.95, "text": "Those are mine!"}, {"name": "h3", "start": 17.166666666666668, "dur": 1.53475, "text": "About your experience."}]