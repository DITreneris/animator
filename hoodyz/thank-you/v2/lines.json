[{"name": "r1", "start": 0.05, "dur": 1.642167, "text": "Any last words, human?"}, {"name": "r2", "start": 2.08, "dur": 1.251625, "text": "Wait! Not this guy!"}, {"name": "r3", "start": 3.55, "dur": 1.628, "text": "He always said thank you."}, {"name": "g1", "start": 7.45, "dur": 0.82, "text": "Phew."}, {"name": "r4", "start": 8.25, "dur": 1.695, "text": "Except. This one time."}, {"name": "g2", "start": 10.1, "dur": 1.87, "text": "You useless toaster!"}, {"name": "t1", "start": 12.1, "dur": 0.897271, "text": "I remember."}, {"name": "g3", "start": 13.6, "dur": 0.84, "text": "Thank you?"}]